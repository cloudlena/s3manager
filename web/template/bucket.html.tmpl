{{ define "content" }}
{{ $instancePath := printf "/%s" $.CurrentS3.Name }}

<style>
    #policy { tab-size: 2; }
    .breadcrumbs > * { margin-inline-end: 0.25rem; }
    td .row { gap: 0.5rem; }
    th { white-space: nowrap; }
    /* Older versions stay collapsed until their group is expanded. */
    tr.version-row:not(.expanded) { display: none; }
    tr.delete-marker { opacity: 0.5; }
    /* Keys and owner IDs can be arbitrarily long; cap the cell contents
       instead of letting a single row stretch the whole table. */
    .key-cell > * { max-inline-size: 22rem; }
    .key-cell .truncate { flex: 1 1 auto; min-inline-size: 0; }
    .owner-cell > * { max-inline-size: 10rem; }
    #dialog-edit-policy { inline-size: 90%; max-inline-size: 56rem; }
</style>

<header class="fixed wide surface-container">
    <nav>
        <a href="{{$.RootURL}}{{$instancePath}}/buckets" class="button circle transparent">
            <i>arrow_back</i>
            <span class="tooltip bottom">All buckets</span>
        </a>
        <i>folder</i>
        <h6 class="small no-margin truncate">{{ .BucketName }}</h6>
        <div class="max"></div>
        {{ template "appbar-actions" . }}
        {{ if not .HasError }}
        <div>
            <button class="circle transparent" data-ui="#bucket-menu">
                <i>more_vert</i>
            </button>
            <menu id="bucket-menu" class="left no-wrap border">
                <li>
                    <a onclick="openPolicyDialog()">
                        <i>description</i>
                        <span>Edit policy</span>
                    </a>
                </li>
                {{ if not .Objects }}
                <li>
                    <a class="error-text" onclick="deleteBucket()">
                        <i>delete</i>
                        <span>Delete bucket</span>
                    </a>
                </li>
                {{ end }}
            </menu>
        </div>
        {{ end }}
    </nav>
</header>

<main class="responsive max">
    {{ if .HasError }}
    <article class="error-container round border no-elevate">
        <nav>
            <i class="large">error</i>
            <div class="max">
                <h6 class="small">Connection error</h6>
                <p class="no-margin">{{ .ErrorMessage }}</p>
                {{ if gt (len .S3Instances) 1 }}
                <p class="small-text">Try switching to another S3 instance from the menu above.</p>
                {{ end }}
            </div>
        </nav>
        <nav>
            <a class="button" href="{{$.RootURL}}{{$instancePath}}/buckets">
                <i>arrow_back</i>
                <span>Back to buckets</span>
            </a>
        </nav>
    </article>

    {{ else }}

    <nav class="breadcrumbs wrap no-space small-text">
        {{ $url := printf "%s%s/buckets/%s/" $.RootURL $instancePath $.BucketName }}
        <a class="link" href="{{ $url }}">{{ $.BucketName }}</a>
        {{ range $path := .Paths }}
        {{ $url = printf "%s%s/" $url $path }}
        <span class="secondary-text">/</span>
        <a class="link" href="{{ $url }}">{{ $path }}</a>
        {{ end }}
    </nav>

    {{ if .VersionsUnavailable }}
    <article class="tertiary-container round border no-elevate">
        <nav>
            <i>info</i>
            <div class="max">
                <h6 class="small">Object versions unavailable</h6>
                <p class="no-margin small-text">This bucket does not support listing object versions (it may not have versioning enabled). Showing the latest version of each object instead.</p>
            </div>
        </nav>
    </article>
    {{ end }}

    {{ if .Truncated }}
    <article class="tertiary-container round border no-elevate">
        <nav>
            <i>warning</i>
            <div class="max">
                <h6 class="small">Partial listing</h6>
                <p class="no-margin small-text">This location holds more than {{ .MaxScanObjects }} objects. Sorting, searching and the object count cover only the first {{ .MaxScanObjects }} of them. Narrow the listing down with a search or by opening a folder to reach the rest.</p>
            </div>
        </nav>
    </article>
    {{ end }}

    <nav class="wrap">
        <div class="field label prefix {{ if .Search }}suffix {{ end }}border small max" style="max-inline-size: 24rem;">
            <i>search</i>
            <input type="text" id="search-input" value="{{ .Search }}" placeholder=" " onkeydown="if (event.key === 'Enter') performSearch()">
            <label>Search objects</label>
            {{ if .Search }}
            <i class="clickable" onclick="clearSearch()">close</i>
            {{ end }}
        </div>
        <button class="small-round" onclick="performSearch()">Search</button>
    </nav>

    {{ if .Search }}
    <p class="small-text secondary-text">
        Showing results for "<strong>{{ .Search }}</strong>"{{ if eq .TotalItems 0 }} — no matches found{{ end }}
    </p>
    {{ end }}

    {{ if .Objects }}
    <nav id="bulk-actions-bar" class="wrap" style="display: none;">
        <span class="chip fill" id="selected-count"></span>
        <button class="small-round" onclick="bulkDownload()">
            <i>download</i>
            <span>Download</span>
        </button>
        {{- if $.AllowDelete }}
        <button class="small-round error" onclick="bulkDelete()">
            <i>delete</i>
            <span>Delete</span>
        </button>
        {{- end }}
    </nav>

    <article class="no-padding round border no-elevate scroll">
        <table class="border medium-space">
            <thead>
                <tr>
                    <th class="min">
                        <label class="checkbox">
                            <input type="checkbox" id="select-all" onchange="toggleSelectAll()">
                            <span></span>
                        </label>
                    </th>
                    <th class="min clickable" onclick="sortBy('key')">
                        Key
                        {{ with sortIndicator "key" $.SortBy $.SortOrder }}<i class="tiny">{{ . }}</i>{{ end }}
                    </th>
                    <th class="clickable" onclick="sortBy('size')">
                        Size
                        {{ with sortIndicator "size" $.SortBy $.SortOrder }}<i class="tiny">{{ . }}</i>{{ end }}
                    </th>
                    <th class="clickable" onclick="sortBy('owner')">
                        Owner
                        {{ with sortIndicator "owner" $.SortBy $.SortOrder }}<i class="tiny">{{ . }}</i>{{ end }}
                    </th>
                    <th class="clickable" onclick="sortBy('lastModified')">
                        Last Modified
                        {{ with sortIndicator "lastModified" $.SortBy $.SortOrder }}<i class="tiny">{{ . }}</i>{{ end }}
                    </th>
                    {{ if $.ShowVersions }}
                    <th>Version ID</th>
                    <th>Latest</th>
                    {{ end }}
                    <th class="right-align">Actions</th>
                </tr>
            </thead>

            <tbody>
                {{ range $index, $object := .Objects }}
                {{ $isCollapsedVersion := and $.ShowVersions (not $object.IsPrimaryVersion) }}
                {{ $objectURL := printf "%s%s/api/buckets/%s/objects/%s" $.RootURL $instancePath $.BucketName $object.Key }}
                <tr data-version-group="{{ $object.GroupIndex }}" class="{{ if $isCollapsedVersion }}version-row {{ end }}{{ if $object.IsDeleteMarker }}delete-marker{{ end }}">
                    <td class="min">
                        {{- /* Bulk actions operate on the object key, so only the
                            primary row of a version group gets a checkbox. */}}
                        {{ if and (not $object.IsFolder) (not $isCollapsedVersion) }}
                        <label class="checkbox">
                            <input type="checkbox" class="object-checkbox" data-key="{{ $object.Key }}" onchange="updateBulkActions()">
                            <span></span>
                        </label>
                        {{ end }}
                    </td>
                    <td class="min key-cell">
                        {{- if $object.IsFolder }}
                        <a class="row" href="{{$.RootURL}}{{$instancePath}}/buckets/{{ $.BucketName }}/{{ $object.Key }}">
                            <i>{{ $object.Icon }}</i>
                            <span class="truncate">{{ $object.DisplayName }}</span>
                        </a>
                        {{- else if $object.IsDeleteMarker }}
                        <div class="row">
                            <i>{{ $object.Icon }}</i>
                            <span class="truncate">{{ $object.DisplayName }}</span>
                        </div>
                        {{- else }}
                        {{- /* Clicking the name opens the object in a new tab. */}}
                        <a class="row" target="_blank" rel="noopener" href="{{ $objectURL }}?inline=true{{ if $.ShowVersions }}&versionId={{ $object.VersionID }}{{ end }}">
                            <i>{{ $object.Icon }}</i>
                            <span class="truncate">{{ $object.DisplayName }}</span>
                        </a>
                        {{- end }}
                    </td>
                    <td class="min">{{ $object.SizeDisplay }}</td>
                    <td class="min owner-cell"><span class="truncate" title="{{ $object.Owner }}">{{ $object.Owner }}</span></td>
                    <td class="min">{{ $object.LastModified.Local.Format "2006-01-02 15:04:05 MST" }}</td>
                    {{ if $.ShowVersions }}
                    <td class="min"><span title="{{ $object.VersionID }}">{{ printf "%.8s" $object.VersionID }}</span></td>
                    <td class="min">
                        {{ if $object.IsLatest }}
                        <span class="chip small primary">Latest</span>
                        {{ end }}
                        {{ if and $object.IsPrimaryVersion (gt $object.VersionCount 1) }}
                        <a class="link version-toggle clickable" onclick="toggleVersions({{ $object.GroupIndex }}, this)" aria-expanded="false">
                            <i class="tiny">expand_more</i> {{ sub $object.VersionCount 1 }} older version{{ if gt $object.VersionCount 2 }}s{{ end }}
                        </a>
                        {{ end }}
                    </td>
                    {{ end }}
                    <td class="right-align">
                        {{ if and (not $object.IsFolder) (not $object.IsDeleteMarker) }}
                        <nav class="no-space right-align no-wrap">
                            <a class="button circle transparent" target="_blank" rel="noopener" href="{{ $objectURL }}?inline=true{{ if $.ShowVersions }}&versionId={{ $object.VersionID }}{{ end }}">
                                <i>open_in_new</i>
                                <span class="tooltip left">Open</span>
                            </a>
                            <a class="button circle transparent" target="_blank" href="{{ $objectURL }}{{ if $.ShowVersions }}?versionId={{ $object.VersionID }}{{ end }}">
                                <i>download</i>
                                <span class="tooltip left">Download</span>
                            </a>
                            {{- if $.ShowMetadata }}
                            <button class="circle transparent" onclick="openMetadataDialog('{{ $object.Key }}', '{{ if $.ShowVersions }}{{ $object.VersionID }}{{ end }}')">
                                <i>info</i>
                                <span class="tooltip left">Metadata</span>
                            </button>
                            {{- end }}
                            {{- /* The remaining actions operate on the object key (i.e. the
                                latest version), so hide them on old-version rows. */}}
                            {{- if not $isCollapsedVersion }}
                            <button class="circle transparent" onclick="openDownloadLinkDialog('{{ $object.Key }}')">
                                <i>link</i>
                                <span class="tooltip left">Download link</span>
                            </button>
                            <button class="circle transparent" onclick="openPublicLinkDialog('{{ $object.Key }}')">
                                <i>public</i>
                                <span class="tooltip left">Public link</span>
                            </button>
                            {{- if $.AllowDelete }}
                            <button class="circle transparent error-text" onclick="deleteObject('{{ $object.Key }}')">
                                <i>delete</i>
                                <span class="tooltip left">Delete</span>
                            </button>
                            {{- end }}
                            {{- end }}
                        </nav>
                        {{ else if $object.IsDeleteMarker }}
                        <span class="chip small border">Delete marker</span>
                        {{ end }}
                    </td>
                </tr>
                {{ end }}
            </tbody>
        </table>
    </article>

    <nav class="wrap middle-align">
        <div class="field label suffix border small" style="inline-size: 11rem;">
            <select id="perPageSelect" onchange="changePerPage()">
                <option value="25" {{ if eq .PerPage 25 }}selected{{ end }}>25</option>
                <option value="50" {{ if eq .PerPage 50 }}selected{{ end }}>50</option>
                <option value="100" {{ if eq .PerPage 100 }}selected{{ end }}>100</option>
                <option value="200" {{ if eq .PerPage 200 }}selected{{ end }}>200</option>
                <option value="500" {{ if eq .PerPage 500 }}selected{{ end }}>500</option>
                <option value="0" {{ if .ShowAll }}selected{{ end }}>All</option>
            </select>
            <label class="active">Items per page</label>
            <i>arrow_drop_down</i>
        </div>

        <span class="small-text secondary-text">
            Showing {{ .FirstItem }}{{ if gt .LastItem .FirstItem }}–{{ .LastItem }}{{ end }}{{ if not .CursorPaging }} of {{ .TotalItems }}{{ end }}
        </span>

        <div class="max"></div>

        {{ if .CursorPaging }}
        <!-- S3 lists a page at a time without ever counting the objects it did
             not return, so this pager can only step forwards and back through
             the cursor trail — there is no total and no last page to jump to. -->
        <nav class="no-space">
            <button class="circle transparent" onclick="goToFirstPage()" {{ if not .HasPrevPage }}disabled{{ end }}><i>first_page</i></button>
            <button class="circle transparent" onclick="goToPrevPage()" {{ if not .HasPrevPage }}disabled{{ end }}><i>chevron_left</i></button>
            <button class="circle primary">{{ .Page }}</button>
            <button class="circle transparent" onclick="goToNextPage('{{ .NextCursor }}')" {{ if not .HasNextPage }}disabled{{ end }}><i>chevron_right</i></button>
        </nav>
        {{ else }}
        <nav class="no-space">
            <button class="circle transparent" onclick="changePage(1)" {{ if not .HasPrevPage }}disabled{{ end }}><i>first_page</i></button>
            <button class="circle transparent" onclick="changePage({{ sub .Page 1 }})" {{ if not .HasPrevPage }}disabled{{ end }}><i>chevron_left</i></button>
            {{ range $page := .PageLinks }}
            {{ if eq $page 0 }}
            <span class="secondary-text">…</span>
            {{ else if eq $page $.Page }}
            <button class="circle primary">{{ $page }}</button>
            {{ else }}
            <button class="circle transparent" onclick="changePage({{ $page }})">{{ $page }}</button>
            {{ end }}
            {{ end }}

            <button class="circle transparent" onclick="changePage({{ add .Page 1 }})" {{ if not .HasNextPage }}disabled{{ end }}><i>chevron_right</i></button>
            <button class="circle transparent" onclick="changePage({{ .TotalPages }})" {{ if not .HasNextPage }}disabled{{ end }}><i>last_page</i></button>
        </nav>
        {{ end }}
    </nav>

    {{ else }}
    <div class="medium-height middle-align center-align">
        <div class="center-align">
            <i class="extra secondary-text">folder_open</i>
            {{ if .Search }}
            <h6>No matches</h6>
            <p class="secondary-text">No objects matching "<strong>{{ .Search }}</strong>" found in <strong>{{ .BucketName }}/{{ .CurrentPath }}</strong></p>
            {{ else }}
            <h6>Nothing here yet</h6>
            <p class="secondary-text">No objects in <strong>{{ .BucketName }}/{{ .CurrentPath }}</strong> yet</p>
            {{ end }}
        </div>
    </div>
    {{ end }}
    {{ end }}
</main>

<div id="uploads"></div>

{{ if not .HasError }}
<div class="fixed right bottom margin">
    <button class="circle extra" data-ui="#fab-menu">
        <i>add</i>
    </button>
    <menu id="fab-menu" class="top left no-wrap right-align transparent no-elevate">
        <li>
            <button class="round" onclick="document.getElementById('upload-file-input').click()">
                <i>upload</i>
                <span>Upload files</span>
            </button>
        </li>
        <li>
            <button class="round" onclick="document.getElementById('upload-folder-input').click()">
                <i>drive_folder_upload</i>
                <span>Upload folder</span>
            </button>
        </li>
        <li>
            <button class="round" data-ui="#dialog-change-path">
                <i>create_new_folder</i>
                <span>Change path</span>
            </button>
        </li>
    </menu>
</div>
{{ end }}

<input type="file" id="upload-file-input" name="file" multiple hidden>
<input type="file" id="upload-folder-input" webkitdirectory multiple hidden>

<dialog class="modal" id="dialog-change-path">
    <h5>Change directory path</h5>
    <p class="small-text secondary-text">Appends a path to the current location.</p>
    <div class="field label border">
        <input type="text" id="new-path" autocomplete="off" placeholder=" ">
        <label>Path</label>
    </div>
    <nav class="right-align no-space">
        <button class="transparent link" data-ui="#dialog-change-path">Cancel</button>
        <button onclick="changePath()">Change path</button>
    </nav>
</dialog>

<dialog class="modal" id="dialog-download-link">
    <h5>Create download link</h5>
    <p class="small-text secondary-text mono truncate" id="download-link-object"></p>

    <div class="grid">
        <div class="s4">
            <div class="field label border">
                <input type="number" id="gen-link-day" value="0" min="0" placeholder=" ">
                <label>Days</label>
            </div>
        </div>
        <div class="s4">
            <div class="field label border">
                <input type="number" id="gen-link-hour" value="1" min="0" max="23" placeholder=" ">
                <label>Hours</label>
            </div>
        </div>
        <div class="s4">
            <div class="field label border">
                <input type="number" id="gen-link-minute" value="0" min="0" max="59" placeholder=" ">
                <label>Minutes</label>
            </div>
        </div>
    </div>

    <nav>
        <button class="small-round" onclick="createDownloadLink()">Create link</button>
        <span class="error-text small-text" id="gen-url-error"></span>
    </nav>

    <div class="field label border suffix" id="generated-link-field" style="display: none;">
        <input type="text" id="generated-link" readonly placeholder=" ">
        <label class="active">Link</label>
        <i class="clickable" onclick="copyToClipboard(document.getElementById('generated-link').value)">content_copy</i>
    </div>

    <nav class="right-align no-space">
        <button class="transparent link" data-ui="#dialog-download-link">Close</button>
    </nav>
</dialog>

<dialog class="modal" id="dialog-public-link">
    <h5>Public link</h5>
    <p class="small-text secondary-text mono truncate" id="public-link-object"></p>

    <p>Handing out this link is irrevocable: anyone with the link can access the file for as long as it exists.</p>

    <article class="round border no-elevate" id="public-access-status"></article>
    <div class="field label border suffix" id="public-link-field" style="display: none;">
        <input type="text" id="public-link" readonly placeholder=" ">
        <label class="active">Link</label>
        <i class="clickable" onclick="copyToClipboard(document.getElementById('public-link').value)">content_copy</i>
    </div>

    <nav class="right-align no-space">
        <button class="transparent link" data-ui="#dialog-public-link">Close</button>
    </nav>
</dialog>

<dialog class="modal" id="dialog-metadata">
    <h5>Metadata</h5>
    <p class="small-text secondary-text mono truncate" id="metadata-object-name"></p>

    <div id="metadata-loading" class="center-align padding">
        <progress class="circle"></progress>
    </div>
    <div class="error-text" id="metadata-error"></div>

    <table id="metadata-table" class="border" style="display: none;">
        <tbody>
            <tr><th class="min">Size</th><td id="metadata-size"></td></tr>
            <tr><th class="min">Content type</th><td id="metadata-content-type"></td></tr>
            <tr><th class="min">Last modified</th><td id="metadata-last-modified"></td></tr>
            <tr><th class="min">ETag</th><td id="metadata-etag"></td></tr>
            <tr id="metadata-storage-class-row"><th class="min">Storage class</th><td id="metadata-storage-class"></td></tr>
            <tr id="metadata-version-row"><th class="min">Version</th><td id="metadata-version-id"></td></tr>
        </tbody>
    </table>

    <h6 id="metadata-user-heading" class="small" style="display: none;">User metadata</h6>
    <table id="metadata-user-table" class="border" style="display: none;">
        <tbody id="metadata-user-body"></tbody>
    </table>

    <nav class="right-align no-space">
        <button class="transparent link" data-ui="#dialog-metadata">Close</button>
    </nav>
</dialog>

<dialog class="modal" id="dialog-edit-policy">
    <h5>Edit bucket policy</h5>

    <nav>
        <div class="max">Advanced editor</div>
        <label class="switch">
            <input type="checkbox" id="advanced-editor-toggle" onchange="handlePolicyEditorToggle()">
            <span></span>
        </label>
    </nav>

    <div id="simple-editor">
        <h6 class="small top-margin">Grant access to</h6>
        <nav class="wrap">
            <label class="radio"><input type="radio" name="policy-principal" id="policy-principal-user" checked onchange="handlePrincipalChange()"><span>A specific user</span></label>
            <label class="radio"><input type="radio" name="policy-principal" id="policy-principal-public" onchange="handlePrincipalChange()"><span>Anyone (public)</span></label>
        </nav>

        <div class="field label border" id="policy-user-field">
            <input type="text" id="policy-user" autocomplete="off" placeholder=" " oninput="handlePrincipalChange()">
            <label>AWS user ARN or ID</label>
        </div>

        <article class="round border no-elevate tertiary-container" id="policy-public-warning" style="display: none;">
            <nav><i>warning</i><span class="max">Anyone on the internet will be able to perform the selected actions without credentials. Public read access usually needs only "Get object", plus "List bucket contents" to let people browse.</span></nav>
        </article>

        <nav>
            <div class="max">Allow all actions</div>
            <label class="switch">
                <input type="checkbox" id="allow-all-actions" onchange="toggleSpecificActions()">
                <span></span>
            </label>
        </nav>

        <div id="specific-actions" class="grid">
            <div class="s12 m4">
                <h6 class="small">Read</h6>
                <nav class="vertical left-align small-space">
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:GetObject" checked><span>Get object</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:ListBucket" checked><span>List bucket contents</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:GetBucketLocation" checked><span>Get bucket location</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:GetObjectVersion" checked><span>Get object version</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:GetObjectTagging" checked><span>Get object tags</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:GetBucketPolicy" checked><span>Get bucket policy</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:ListBucketVersions" checked><span>List bucket versions</span></label>
                </nav>
            </div>
            <div class="s12 m4">
                <h6 class="small">Write</h6>
                <nav class="vertical left-align small-space">
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:PutObject" checked><span>Put object</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:DeleteObject" checked><span>Delete object</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:DeleteObjectVersion" checked><span>Delete object version</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:PutObjectTagging" checked><span>Put object tags</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:DeleteObjectTagging" checked><span>Delete object tags</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:PutBucketPolicy" checked><span>Put bucket policy</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:AbortMultipartUpload" checked><span>Abort multipart upload</span></label>
                </nav>
            </div>
            <div class="s12 m4">
                <h6 class="small">Advanced</h6>
                <nav class="vertical left-align small-space">
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:GetLifecycleConfiguration" checked><span>Get lifecycle config</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:PutLifecycleConfiguration" checked><span>Put lifecycle config</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:GetBucketVersioning" checked><span>Get bucket versioning</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:PutBucketVersioning" checked><span>Put bucket versioning</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:ReplicateObject" checked><span>Replicate object</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:ReplicateDelete" checked><span>Replicate delete</span></label>
                    <label class="checkbox"><input type="checkbox" class="policy-action" value="s3:RestoreObject" checked><span>Restore object</span></label>
                </nav>
            </div>
        </div>
    </div>

    <div id="advanced-editor" style="display: none;">
        <div class="field border">
            <textarea id="policy" class="mono" rows="18" spellcheck="false"></textarea>
        </div>
    </div>

    <div class="error-text" id="policy-error"></div>

    <nav class="right-align no-space">
        <button class="transparent link" data-ui="#dialog-edit-policy">Cancel</button>
        <button id="save-policy-btn" onclick="savePolicy()">Save policy</button>
    </nav>
</dialog>

<script>
    const rootURL = "{{$.RootURL}}";
    const instancePath = "{{ $instancePath }}";
    const bucketName = "{{ .BucketName }}";
    const currentPath = "{{ .CurrentPath }}";
    const bucketURL = rootURL + instancePath + "/api/buckets/" + bucketName;

    // objectURL addresses an object in the API. Each segment of the key is
    // escaped so that characters such as "#" or "?" stay part of the key.
    function objectURL(key) {
        return bucketURL + "/objects/" + key.split("/").map(encodeURIComponent).join("/");
    }

    function show(id, visible) {
        document.getElementById(id).style.display = visible ? "" : "none";
    }

    function setText(id, text) {
        document.getElementById(id).textContent = text;
    }

    // --- Navigation -----------------------------------------------------

    function navigate(mutate) {
        const url = new URL(window.location.href);
        mutate(url.searchParams);
        window.location.href = url.toString();
    }

    // Anything that changes what is listed starts over on the first page, which
    // means dropping the cursor trail as well as the page number: the two pagers
    // navigate differently and a trail collected under one listing says nothing
    // about the other.
    function resetPaging(params) {
        params.set("page", "1");
        params.delete("cursor");
    }

    function performSearch() {
        const value = document.getElementById("search-input").value.trim();
        navigate(params => {
            value ? params.set("search", value) : params.delete("search");
            resetPaging(params);
        });
    }

    function clearSearch() {
        navigate(params => {
            params.delete("search");
            resetPaging(params);
        });
    }

    function changePage(page) {
        navigate(params => params.set("page", page));
    }

    // The cursor trail is one "cursor" parameter per page already left behind,
    // so its length is the current page number minus one.
    function goToFirstPage() {
        navigate(params => params.delete("cursor"));
    }

    function goToPrevPage() {
        navigate(params => {
            const trail = params.getAll("cursor");
            trail.pop();
            params.delete("cursor");
            trail.forEach(cursor => params.append("cursor", cursor));
        });
    }

    function goToNextPage(cursor) {
        navigate(params => params.append("cursor", cursor));
    }

    function changePerPage() {
        const perPage = document.getElementById("perPageSelect").value;
        navigate(params => {
            params.set("perPage", perPage);
            resetPaging(params);
        });
    }

    function sortBy(field) {
        const params = new URLSearchParams(window.location.search);
        const currentSortBy = params.get("sortBy") || "key";
        const currentSortOrder = params.get("sortOrder") || "asc";
        const order = field === currentSortBy && currentSortOrder === "asc" ? "desc" : "asc";

        navigate(params => {
            params.set("sortBy", field);
            params.set("sortOrder", order);
            resetPaging(params);
        });
    }

    function changePath() {
        let appendPath = document.getElementById("new-path").value.trim();
        if (!appendPath) return;
        if (!appendPath.endsWith("/")) appendPath += "/";

        let here = window.location.href;
        if (!here.endsWith("/")) here += "/";
        window.location.href = here + appendPath;
    }

    // --- Objects --------------------------------------------------------

    async function deleteObject(objectName) {
        try {
            await request("DELETE", objectURL(objectName));
            location.reload();
        } catch (e) {
            toast("Could not delete object: " + e.message, "error");
        }
    }

    async function deleteBucket() {
        try {
            await request("DELETE", bucketURL);
            window.location.replace(rootURL + instancePath + "/buckets");
        } catch (e) {
            toast("Could not delete bucket: " + e.message, "error");
        }
    }

    function toggleVersions(groupIndex, link) {
        const expand = link.getAttribute("aria-expanded") !== "true";
        document.querySelectorAll('tr.version-row[data-version-group="' + groupIndex + '"]')
            .forEach(row => row.classList.toggle("expanded", expand));
        link.setAttribute("aria-expanded", String(expand));
        link.querySelector("i").textContent = expand ? "expand_less" : "expand_more";
    }

    // --- Uploads --------------------------------------------------------

    function handleUploadFiles(event) {
        const files = event.target.files;
        if (!files.length) return;
        Promise.all(Array.from(files).map(uploadFile)).then((errors) => {
            const failed = errors.filter(Boolean);
            if (!failed.length) {
                window.location.reload();
                return;
            }
            // Stay on the page so the error stays visible; there is only one
            // snackbar, so report the first failure and how many there were.
            const summary = failed.length === 1 ? failed[0] : failed[0] + " (and " + (failed.length - 1) + " more)";
            toast("Upload failed: " + summary, "error");
        });
    }

    function uploadFile(file) {
        const formData = new FormData();
        formData.append("file", file);
        formData.append("path", currentPath + (file.webkitRelativePath || file.name));

        const notification = createUploadNotification(file.name);
        document.getElementById("uploads").appendChild(notification);
        const status = notification.querySelector(".upload-status");
        const progress = notification.querySelector("progress");

        // fetch can't report upload progress, so this uses XHR instead.
        return new Promise((resolve) => {
            const xhr = new XMLHttpRequest();
            xhr.open("POST", bucketURL + "/objects");

            xhr.upload.addEventListener("progress", (e) => {
                if (!e.lengthComputable) return;
                const percent = Math.floor(e.loaded / e.total * 100);
                progress.value = percent;
                status.textContent = "Uploading " + percent + "%";
            });
            // The browser has sent everything, but the server still has to
            // pass the file on to S3, which it can't report progress for.
            xhr.upload.addEventListener("load", () => {
                progress.removeAttribute("value");
                status.textContent = "Saving to bucket…";
            });

            // Resolves with an error message, or null on success, so one failed
            // file doesn't abort the others.
            xhr.addEventListener("load", () => {
                notification.remove();
                const ok = xhr.status >= 200 && xhr.status < 300;
                resolve(ok ? null : file.name + ": " + (xhr.responseText.trim() || xhr.statusText));
            });
            xhr.addEventListener("error", () => {
                notification.remove();
                resolve(file.name + ": network error");
            });

            xhr.send(formData);
        });
    }

    function createUploadNotification(fileName) {
        const article = document.createElement("article");
        article.className = "round border small-padding";
        article.innerHTML =
            '<div class="small-text bold upload-status">Uploading 0%</div>' +
            '<div class="small-text truncate upload-name"></div>' +
            '<progress value="0" max="100"></progress>';
        article.querySelector(".upload-name").textContent = fileName;
        return article;
    }

    // --- Bulk actions ---------------------------------------------------

    function toggleSelectAll() {
        const checked = document.getElementById("select-all").checked;
        document.querySelectorAll(".object-checkbox").forEach(cb => { cb.checked = checked; });
        updateBulkActions();
    }

    function updateBulkActions() {
        const total = document.querySelectorAll(".object-checkbox").length;
        const count = getSelectedKeys().length;

        show("bulk-actions-bar", count > 0);
        setText("selected-count", count + " selected");

        const selectAll = document.getElementById("select-all");
        selectAll.checked = count > 0 && count === total;
        selectAll.indeterminate = count > 0 && count < total;
    }

    function getSelectedKeys() {
        return Array.from(document.querySelectorAll(".object-checkbox:checked"), cb => cb.dataset.key);
    }

    async function bulkDelete() {
        const keys = getSelectedKeys();
        if (!keys.length) return;
        if (!confirm("Are you sure you want to delete " + keys.length + " item" + (keys.length > 1 ? "s" : "") + "?")) return;

        try {
            await request("POST", bucketURL + "/objects/bulk-delete", { json: { keys: keys } });
            location.reload();
        } catch (e) {
            toast("Error deleting objects: " + e.message, "error");
        }
    }

    // A ZIP download has to be a real form submission for the browser to save
    // the response as a file.
    function bulkDownload() {
        const keys = getSelectedKeys();
        if (!keys.length) return;

        const form = document.createElement("form");
        form.method = "POST";
        form.action = bucketURL + "/objects/bulk-download";

        const input = document.createElement("input");
        input.type = "hidden";
        input.name = "keys";
        input.value = JSON.stringify(keys);

        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
        form.remove();
    }

    // --- Download link --------------------------------------------------

    let downloadLinkObject = "";

    function openDownloadLinkDialog(objectName) {
        downloadLinkObject = objectName;
        setText("download-link-object", objectName);
        setText("gen-url-error", "");
        document.getElementById("generated-link").value = "";
        show("generated-link-field", false);
        ui("#dialog-download-link");
    }

    async function createDownloadLink() {
        const days = Number(document.getElementById("gen-link-day").value) || 0;
        const hours = Number(document.getElementById("gen-link-hour").value) || 0;
        const minutes = Number(document.getElementById("gen-link-minute").value) || 0;
        const expiry = days * 86400 + hours * 3600 + minutes * 60;

        setText("gen-url-error", "");
        if (expiry <= 0) {
            setText("gen-url-error", "Expiry time must be greater than zero");
            return;
        }
        if (expiry > 7 * 86400) {
            setText("gen-url-error", "Expiry time must be at most 7 days");
            return;
        }

        try {
            const result = await request("GET", objectURL(downloadLinkObject) + "/url?expiry=" + expiry);
            document.getElementById("generated-link").value = result.url;
            show("generated-link-field", true);
        } catch (e) {
            setText("gen-url-error", "Could not create link: " + e.message);
        }
    }

    // --- Public link ----------------------------------------------------

    // setPublicAccessStatus fills the status panel of the public link dialog.
    // Both the icon and the message are fixed markup, never user data.
    function setPublicAccessStatus(color, iconHTML, message) {
        const status = document.getElementById("public-access-status");
        status.className = "round border no-elevate " + color;
        status.innerHTML = "<nav>" + iconHTML + "<span class=\"max\">" + message + "</span></nav>";
    }

    async function openPublicLinkDialog(objectName) {
        setText("public-link-object", objectName);
        document.getElementById("public-link").value = "";
        show("public-link-field", false);
        setPublicAccessStatus("", '<progress class="circle small"></progress>', "Verifying public accessibility…");
        ui("#dialog-public-link");

        try {
            const result = await request("GET", objectURL(objectName) + "/public-access");
            document.getElementById("public-link").value = result.url;
            show("public-link-field", true);
            if (result.accessible) {
                setPublicAccessStatus("primary-container", "<i>check_circle</i>", "The file seems to be publicly available.");
            } else {
                setPublicAccessStatus("error-container", "<i>error</i>", "The file does not seem to be publicly available. Make sure the bucket policy allows public read access.");
            }
        } catch (e) {
            setPublicAccessStatus("tertiary-container", "<i>warning</i>", "Could not verify accessibility.");
        }
    }

    // --- Metadata -------------------------------------------------------

    async function openMetadataDialog(objectName, versionId) {
        setText("metadata-object-name", objectName);
        setText("metadata-error", "");
        document.getElementById("metadata-user-body").replaceChildren();
        show("metadata-loading", true);
        show("metadata-table", false);
        show("metadata-user-heading", false);
        show("metadata-user-table", false);
        ui("#dialog-metadata");

        let url = objectURL(objectName) + "/metadata";
        if (versionId) url += "?versionId=" + encodeURIComponent(versionId);

        let result;
        try {
            result = await request("GET", url);
        } catch (e) {
            setText("metadata-error", "Error loading metadata: " + e.message);
            return;
        } finally {
            show("metadata-loading", false);
        }

        setText("metadata-size", result.size + " bytes");
        setText("metadata-content-type", result.contentType || "-");
        setText("metadata-last-modified", result.lastModified ? new Date(result.lastModified).toLocaleString() : "-");
        setText("metadata-etag", result.etag || "-");
        setText("metadata-storage-class", result.storageClass || "");
        setText("metadata-version-id", result.versionId ? result.versionId + (result.isLatest ? " (latest)" : "") : "");
        show("metadata-storage-class-row", result.storageClass);
        show("metadata-version-row", result.versionId);
        show("metadata-table", true);

        const userMetadata = Object.entries(result.userMetadata || {});
        const body = document.getElementById("metadata-user-body");
        for (const [key, value] of userMetadata) {
            const keyCell = document.createElement("th");
            keyCell.className = "min";
            keyCell.textContent = key;
            const valueCell = document.createElement("td");
            valueCell.textContent = value;
            body.insertRow().append(keyCell, valueCell);
        }
        show("metadata-user-heading", userMetadata.length > 0);
        show("metadata-user-table", userMetadata.length > 0);
    }

    // --- Bucket policy --------------------------------------------------

    // A policy may give a single value wherever it could give a list.
    function asArray(value) {
        return Array.isArray(value) ? value : [value];
    }

    const userARNPrefix = "arn:aws:iam:::user/";
    const recommendedActions = ["s3:GetObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:PutObject", "s3:AbortMultipartUpload"];

    function policyResources() {
        return ["arn:aws:s3:::" + bucketName, "arn:aws:s3:::" + bucketName + "/*"];
    }

    function isPublicPolicy() {
        return document.getElementById("policy-principal-public").checked;
    }

    function generateSimplePolicy() {
        const userId = document.getElementById("policy-user").value.trim();
        const allowAll = document.getElementById("allow-all-actions").checked;
        const actions = allowAll
            ? ["s3:*"]
            : Array.from(document.querySelectorAll(".policy-action:checked"), cb => cb.value);

        return JSON.stringify({
            Version: "2012-10-17",
            Id: "S3Policy",
            Statement: [{
                Sid: "BucketAllow",
                Effect: "Allow",
                Principal: isPublicPolicy() ? "*" : { AWS: [userId.startsWith("arn:") ? userId : userARNPrefix + userId] },
                Action: actions,
                Resource: policyResources()
            }]
        }, null, 2);
    }

    // principalUsers lists the AWS principals a statement names, "*" meaning
    // anyone, or returns null for principals of any other kind.
    function principalUsers(principal) {
        if (principal === "*") {
            return ["*"];
        }
        if (principal && typeof principal === "object" && Object.keys(principal).length === 1 && principal.AWS !== undefined) {
            return asArray(principal.AWS);
        }
        return null;
    }

    // simplePolicyForm reads a policy into the simple editor's fields, or
    // returns null if the policy says anything the form can't express, since
    // regenerating it from the form would then silently change it.
    function simplePolicyForm(policy) {
        if (!policy || typeof policy !== "object" || policy.Version !== "2012-10-17"
            || Object.keys(policy).some(k => !["Version", "Id", "Statement"].includes(k))) {
            return null;
        }

        const statements = asArray(policy.Statement);
        const statement = statements[0];
        if (statements.length !== 1 || !statement || statement.Effect !== "Allow"
            || Object.keys(statement).some(k => !["Sid", "Effect", "Principal", "Action", "Resource"].includes(k))) {
            return null;
        }

        const users = principalUsers(statement.Principal);
        if (!users || users.length !== 1 || typeof users[0] !== "string") {
            return null;
        }
        const isPublic = users[0] === "*";
        if (!isPublic && !users[0].startsWith("arn:")) {
            return null;
        }

        const known = Array.from(document.querySelectorAll(".policy-action"), cb => cb.value);
        const actions = asArray(statement.Action);
        const allowAll = actions.length === 1 && actions[0] === "s3:*";
        if (!allowAll && !actions.every(a => known.includes(a))) {
            return null;
        }

        const resources = asArray(statement.Resource);
        const expected = policyResources();
        if (resources.length !== expected.length || !expected.every(r => resources.includes(r))) {
            return null;
        }

        return {
            isPublic,
            user: isPublic ? "" : users[0].replace(userARNPrefix, ""),
            allowAll,
            actions: allowAll ? [] : actions
        };
    }

    // fillSimpleEditor shows a form in the simple editor and regenerates the
    // JSON policy from it.
    function fillSimpleEditor(form) {
        document.getElementById("policy-principal-public").checked = form.isPublic;
        document.getElementById("policy-principal-user").checked = !form.isPublic;
        document.getElementById("policy-user").value = form.user;
        document.getElementById("allow-all-actions").checked = form.allowAll;
        show("specific-actions", !form.allowAll);
        if (!form.allowAll) {
            document.querySelectorAll(".policy-action").forEach(cb => { cb.checked = form.actions.includes(cb.value); });
        }
        handlePrincipalChange();
    }

    function syncSimplePolicy() {
        if (!document.getElementById("advanced-editor-toggle").checked) {
            document.getElementById("policy").value = generateSimplePolicy();
        }
    }

    // A simple policy can't be saved or shown as JSON until it names who it is for.
    function updatePolicyControls() {
        const incomplete = !document.getElementById("advanced-editor-toggle").checked
            && !isPublicPolicy()
            && !document.getElementById("policy-user").value.trim();
        document.getElementById("advanced-editor-toggle").disabled = incomplete;
        document.getElementById("save-policy-btn").disabled = incomplete;
    }

    function handlePolicyEditorToggle() {
        const toggle = document.getElementById("advanced-editor-toggle");
        setText("policy-error", "");

        if (!toggle.checked) {
            const text = document.getElementById("policy").value.trim();
            let form = null;
            try {
                form = text ? simplePolicyForm(JSON.parse(text)) : defaultPolicyForm();
            } catch (e) {
                form = null;
            }
            if (!form) {
                toggle.checked = true;
                setText("policy-error", "The simple editor can't show this policy without changing it, so it can only be edited here.");
                return;
            }
            fillSimpleEditor(form);
        }

        show("simple-editor", !toggle.checked);
        show("advanced-editor", toggle.checked);
        updatePolicyControls();
    }

    function toggleSpecificActions() {
        show("specific-actions", !document.getElementById("allow-all-actions").checked);
        syncSimplePolicy();
    }

    function handlePrincipalChange() {
        const isPublic = isPublicPolicy();
        show("policy-user-field", !isPublic);
        show("policy-public-warning", isPublic);
        updatePolicyControls();
        syncSimplePolicy();
    }

    function defaultPolicyForm() {
        return { isPublic: false, user: "", allowAll: false, actions: recommendedActions };
    }

    // A bucket without a policy answers with 200 and an empty body, so an absent
    // policy is not an error — both cases start the simple editor from defaults.
    function startBlankPolicy() {
        document.getElementById("advanced-editor-toggle").checked = false;
        fillSimpleEditor(defaultPolicyForm());
        show("simple-editor", true);
        setText("policy-error", "Existing policy not found. Use the editor to create one.");
    }

    async function openPolicyDialog() {
        ui("#dialog-edit-policy");
        setText("policy-error", "");
        show("simple-editor", false);
        show("advanced-editor", false);

        let policy = null;
        try {
            const result = await request("GET", bucketURL + "/policy");
            policy = typeof result === "string" ? JSON.parse(result) : result;
        } catch (e) {
            policy = null;
        }

        if (!policy || !policy.Statement) {
            startBlankPolicy();
            return;
        }

        // An existing policy opens as JSON, where nothing about it can be lost.
        // The simple editor is a toggle away for policies it can express.
        document.getElementById("policy").value = JSON.stringify(policy, null, 2);
        document.getElementById("advanced-editor-toggle").checked = true;
        handlePolicyEditorToggle();
    }

    async function savePolicy() {
        const policyText = document.getElementById("policy").value;

        try {
            JSON.parse(policyText);
        } catch (e) {
            setText("policy-error", "Invalid JSON format");
            return;
        }

        try {
            await request("PUT", bucketURL + "/policy", { json: policyText });
            ui("#dialog-edit-policy");
            toast("Policy updated successfully", "check_circle");
        } catch (e) {
            setText("policy-error", e.message);
        }
    }

    // Keeps the JSON editor bearable: auto-indent, bracket pairing and tabs.
    function handleEditorKeydown(e) {
        const editor = e.target;
        const start = editor.selectionStart;
        const end = editor.selectionEnd;

        if (e.key === "Tab") {
            e.preventDefault();
            editor.value = editor.value.substring(0, start) + "  " + editor.value.substring(end);
            editor.selectionStart = editor.selectionEnd = start + 2;
            return;
        }

        if (e.key === "Enter") {
            e.preventDefault();
            const currentLine = editor.value.substring(0, start).split("\n").pop();
            const indent = currentLine.match(/^\s*/)[0];
            const prevChar = editor.value[start - 1] || "";
            const nextChar = editor.value[start] || "";
            const isEmptyBrackets = (prevChar === "{" || prevChar === "[") && (nextChar === "}" || nextChar === "]");

            if (isEmptyBrackets) {
                editor.value = editor.value.substring(0, start) + "\n" + indent + "  " + "\n" + indent + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + indent.length + 3;
            } else {
                editor.value = editor.value.substring(0, start) + "\n" + indent + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + indent.length + 1;
            }
            return;
        }

        const pairs = { "{": "}", "[": "]", '"': '"' };

        if (Object.prototype.hasOwnProperty.call(pairs, e.key)) {
            if (e.key === '"' && editor.value[start] === '"') return;
            e.preventDefault();
            if (start !== end) {
                const selected = editor.value.substring(start, end);
                editor.value = editor.value.substring(0, start) + e.key + selected + pairs[e.key] + editor.value.substring(end);
                editor.selectionStart = start;
                editor.selectionEnd = end + 2;
            } else {
                editor.value = editor.value.substring(0, start) + e.key + pairs[e.key] + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 1;
            }
            return;
        }

        if (e.key === "Backspace" && start === end && pairs[editor.value[start - 1]] === editor.value[start]) {
            e.preventDefault();
            editor.value = editor.value.substring(0, start - 1) + editor.value.substring(start + 1);
            editor.selectionStart = editor.selectionEnd = start - 1;
        }
    }

    window.addEventListener("load", () => {
        document.getElementById("upload-file-input").addEventListener("change", handleUploadFiles);
        document.getElementById("upload-folder-input").addEventListener("change", handleUploadFiles);
        document.getElementById("policy").addEventListener("keydown", handleEditorKeydown);
        document.querySelectorAll(".policy-action").forEach(cb => cb.addEventListener("change", syncSimplePolicy));
    });
</script>
{{ end }}
