{{ define "content" }}
{{ $instancePath := printf "/%s" $.CurrentS3.Name }}

<header class="fixed surface-container">
    <nav>
        <a href="{{$.RootURL}}{{$instancePath}}/buckets" class="row no-margin">
            <i>database</i>
            <h6 class="small no-margin">S3 Manager</h6>
        </a>
        <div class="max"></div>
        {{ template "appbar-actions" . }}
    </nav>
</header>

<main class="responsive">
    {{ if .HasError }}
    <article class="error-container round border no-elevate">
        <nav>
            <i class="large">error</i>
            <div class="max">
                <h6 class="small">Connection error</h6>
                <p class="no-margin">{{ .ErrorMessage }}</p>
                {{ if gt (len .S3Instances) 1 }}
                <p class="small-text">Try switching to another S3 instance from the menu above.</p>
                {{ end }}
            </div>
        </nav>
    </article>

    {{ else if .Buckets }}
    <div class="grid">
        {{ range $bucket := .Buckets }}
        <div class="s12 m6 l4">
            <article class="no-padding round border no-elevate">
                <a class="row padding wave" href="{{$.RootURL}}{{$instancePath}}/buckets/{{ $bucket.Name }}">
                    <i class="large">folder</i>
                    <div class="max">
                        <h6 class="small no-margin truncate">{{ $bucket.Name }}</h6>
                        <div class="small-text secondary-text">Created {{ $bucket.CreationDate.Local.Format "2006-01-02" }}</div>
                    </div>
                    <i>chevron_right</i>
                </a>
            </article>
        </div>
        {{ end }}
    </div>

    {{ else }}
    <div class="medium-height middle-align center-align">
        <div class="center-align">
            <i class="extra secondary-text">folder_open</i>
            <h6>No buckets yet</h6>
            <p class="secondary-text">Create your first bucket to get started.</p>
            <div class="space"></div>
            <button class="round" data-ui="#dialog-create-bucket">
                <i>add</i>
                <span>Create bucket</span>
            </button>
        </div>
    </div>
    {{ end }}
</main>

{{ if not .HasError }}
<button class="circle extra fixed right bottom margin" data-ui="#dialog-create-bucket">
    <i>add</i>
    <span class="tooltip left">Create bucket</span>
</button>
{{ end }}

<dialog class="modal" id="dialog-create-bucket">
    <h5>Create bucket</h5>
    <div class="field label border">
        <input type="text" id="bucket-name" autocomplete="off" placeholder=" ">
        <label>Name</label>
    </div>
    <div class="error-text" id="create-bucket-error"></div>
    <nav class="right-align no-space">
        <button class="transparent link" data-ui="#dialog-create-bucket">Cancel</button>
        <button onclick="createBucket()">Create</button>
    </nav>
</dialog>

<script>
    async function createBucket() {
        const name = document.getElementById("bucket-name").value.trim();
        const error = document.getElementById("create-bucket-error");
        error.textContent = "";

        if (!name) {
            error.textContent = "Please enter a bucket name.";
            return;
        }

        try {
            await request("POST", "{{$.RootURL}}{{$instancePath}}/api/buckets", { json: { name: name } });
            location.reload();
        } catch (e) {
            error.textContent = e.message;
        }
    }
</script>
{{ end }}
